NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=reporter_ro
DB_PASSWORD=change_me
DB_NAME=business_db

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Every day at 19:00 (minute hour day month weekday)
REPORT_CRON_SCHEDULE=0 19 * * *
REPORT_TIMEZONE=Europe/Istanbul
REPORT_CURRENCY=TRY

# Instant alerts (out of stock, no orders during business hours)
ALERTS_ENABLED=true
ALERT_CRON_SCHEDULE=*/15 * * * *
ALERT_NO_ORDER_HOURS=3
# Business hours (start-end, 24h) and ISO weekdays (1=Mon … 7=Sun)
ALERT_BUSINESS_HOURS=9-18
ALERT_BUSINESS_DAYS=1-5
